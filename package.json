{
  "name": "logseq-progressbar",
  "version": "0.1.0",
  "author": "Danzu",
  "description": "Visualize task completion as segmented progress bars in Logseq DB graphs",
  "license": "MIT",
  "logseq": {
    "id": "logseq-progressbar",
    "title": "Progress Bar",
    "icon": "./icon.svg",
    "main": "dist/index.html",
    "supportsDB": true,
    "supportsDBOnly": true,
    "minSDKVersion": "0.3.2"
  },
  "scripts": {
    "dev": "vite build --watch",
    "dev:serve": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@logseq/libs": "^0.3.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vite-plugin-logseq": "^1.1.2",
    "vitest": "^3.0.0"
  }
}
