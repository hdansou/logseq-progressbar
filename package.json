{
  "name": "logseq-progressbar",
  "version": "1.3.0",
  "author": "Danzu",
  "description": "Visualize task completion as segmented progress bars in Logseq DB graphs",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/hdansou/logseq-progressbar#readme",
  "bugs": {
    "url": "https://github.com/hdansou/logseq-progressbar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hdansou/logseq-progressbar.git"
  },
  "keywords": [
    "logseq",
    "logseq-plugin",
    "logseq-db",
    "progress-bar",
    "tasks",
    "productivity"
  ],
  "engines": {
    "node": ">=24"
  },
  "logseq": {
    "id": "logseq-progressbar",
    "title": "Progress Bar",
    "description": "Visualize task completion as segmented progress bars in Logseq DB graphs",
    "icon": "./icon.svg",
    "main": "dist/index.html",
    "minSDKVersion": "0.3.4",
    "web": true,
    "effect": false,
    "supportsDB": true,
    "supportsDBOnly": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "scripts/e2e/progress-matrix.sh",
    "e2e:desktop": "scripts/e2e/desktop-matrix.sh"
  },
  "dependencies": {
    "@logseq/libs": "^0.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.9.1"
}
